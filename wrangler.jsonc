{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wikigems",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/g/*"],
  },
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [
    { "binding": "AVATARS", "bucket_name": "wikigems-avatars", "remote": true },
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "secrets": {
    "required": [
      "TURSO_DATABASE_URL",
      "TURSO_AUTH_TOKEN",
      "BETTER_AUTH_SECRET",
      "RESEND_API_KEY",
      "SPONSOR_SECRET_KEY",
      "MINT_AUTHORITY_SECRET_KEY",
    ],
  },
  "vars": {
    // Empty values let production infer these from the request. During local
    // development, Wrangler replaces them with envchain's process environment.
    "BETTER_AUTH_URL": "",
    "PASSKEY_RP_ID": "",
    "PASSKEY_ORIGIN": "",
    "TRUSTED_ORIGINS": "",
    "SOLANA_RPC_URL": "https://api.devnet.solana.com",
    "SOLANA_CLUSTER": "devnet",
    "WIKIGEMS_PROGRAM_ID": "3KBQ1Y9YZbKmYKhnXM1u8fcEBHEtizgW3hcBZSYnuUjL",
    "USDC_MINT": "4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU",
    "TREASURY_WALLET": "",
    "MARKET_FEE_BPS": "250",
    "CLAIM_PRICE_USDC_MINOR": "250000",
    "FREE_CLAIMS_PER_USER": "1",
    "PUBLIC_ORIGIN": "",
    "EMAIL_FROM": "",
  },
  "workers_dev": true,
  "preview_urls": false,
}
