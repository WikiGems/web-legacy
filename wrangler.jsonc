{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wikigems",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [
    { "binding": "AVATARS", "bucket_name": "wikigems-avatars", "remote": true },
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "secrets": {
    "required": ["TURSO_DATABASE_URL", "TURSO_AUTH_TOKEN", "BETTER_AUTH_SECRET"],
  },
  "vars": {
    // Empty values let production infer these from the request. During local
    // development, Wrangler replaces them with envchain's process environment.
    "BETTER_AUTH_URL": "",
    "PASSKEY_RP_ID": "",
    "PASSKEY_ORIGIN": "",
    "TRUSTED_ORIGINS": "",
    "SOLANA_RPC_URL": "https://api.devnet.solana.com",
    "SOLANA_CLUSTER": "devnet",
  },
  "workers_dev": true,
  "preview_urls": false,
}
