# Settings reference for envchain. See docs/envchain.md.
# To migrate a local .env, run bun run secrets:import. Development uses Keychain.
# For hosted Turso, replace the URL and set a database auth token.
TURSO_DATABASE_URL="http://127.0.0.1:8080"
TURSO_AUTH_TOKEN=""
# Replace with: openssl rand -base64 48
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"
PASSKEY_RP_ID="localhost"
PASSKEY_ORIGIN="http://localhost:5173"
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_CLUSTER="devnet"

# Optional email verification (Resend). Use a sender on your verified domain.
RESEND_API_KEY=""
EMAIL_FROM=""

# Optional Solana purchases and claims. Store both keys in Keychain.
SPONSOR_SECRET_KEY=""
MINT_AUTHORITY_SECRET_KEY=""
WIKIGEMS_PROGRAM_ID="3KBQ1Y9YZbKmYKhnXM1u8fcEBHEtizgW3hcBZSYnuUjL"
USDC_MINT="4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"
TREASURY_WALLET=""
