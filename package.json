{
  "name": "wikigems",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "WikiGems \u2014 the Wikipedia trading card game. One article, one 1-of-1 card, minted on Solana.",
  "scripts": {
    "dev": "bun run scripts/with-env.ts bun run scripts/dev.ts",
    "dev:web": "bun run scripts/with-env.ts vite --port 5173",
    "dev:worker": "bun run scripts/with-env.ts wrangler dev --port 8787",
    "dev:db": "turso dev --db-file .data/wikigems.db --port 8080",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "deploy": "bun run build && wrangler deploy",
    "db:migrate": "bun run scripts/with-env.ts bun run scripts/migrate.ts",
    "db:generate": "bun run scripts/with-env.ts bun run scripts/generate-auth-schema.ts",
    "secrets:decrypt": "sh scripts/secrets.sh decrypt",
    "secrets:encrypt": "sh scripts/secrets.sh encrypt",
    "secrets:edit": "sh scripts/secrets.sh edit",
    "test:e2e": "bun run scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:mint": "bun run scripts/mint-e2e.ts",
    "test:trade": "bun run scripts/trade-e2e.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.10",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@libsql/client": "0.18.0",
    "@libsql/kysely-libsql": "0.4.1",
    "@metaplex-foundation/mpl-core": "1.10.0",
    "@metaplex-foundation/umi": "1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "1.6.0",
    "@metaplex-foundation/umi-signer-wallet-adapters": "1.6.0",
    "@solana/web3.js": "1.99.0",
    "@solidjs/router": "1.0.0",
    "better-auth": "1.7.10",
    "bs58": "6.0.0",
    "effect": "4.0.5",
    "kysely": "0.29.6",
    "solid-js": "1.9.17",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/bun": "1.4.3",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14",
    "wrangler": "4.148.0"
  },
  "packageManager": "bun@1.4.2"
}
