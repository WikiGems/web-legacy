{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.md",
    "bun.lock",
    "dist/**",
    "target/**",
    ".wrangler/**",
    ".flox/**",
    ".artifacts/**",
    "secrets/**",
    "migrations/**",
    "programs/**",
    "public/**",
    "node_modules/**"
  ]
}
